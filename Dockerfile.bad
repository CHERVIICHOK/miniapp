FROM python:3.12

WORKDIR /app

# Плохой вариант: весь контекст (включая .venv, .git, .runtime и .tools)
# копируется до установки зависимостей.
COPY . .
RUN pip install -r requirements.txt

# Плохой вариант: контейнер работает от root, нет HEALTHCHECK и слои не кешируются.
EXPOSE 8000
CMD uvicorn app.main:create_app --factory --host 0.0.0.0 --port 8000
